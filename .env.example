# ==============================================================================
# RepoLens Backend Environment Variables
# Author: Yogesh Pant (@Yogeshpant942)
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database (Supabase / Neon / Local PostgreSQL with pgvector extension)
DATABASE_URL="postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres"

# Supabase Vector Store & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your_project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# AI Models & APIs
# Google Gemini API key (for Gemini 2.0 Flash and text-embedding-004)
GEMINI_API_KEY="your_gemini_api_key_here"

# AssemblyAI API key (for speaker diarization & meeting transcription)
ASSEMBLY_API_KEY="your_assemblyai_api_key_here"

# Recall.ai API key (for autonomous meeting bot joining Google Meet / Zoom)
RECALL_API_KEY="your_recall_api_key_here"

# GitHub Integration
# Personal access token with repo and pull_requests permissions
GITHUB_ACCESS_TOKEN="your_github_personal_access_token_here"
# Secret for validating GitHub Webhook signatures
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret_here"
